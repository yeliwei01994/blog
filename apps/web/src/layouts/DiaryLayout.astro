---
import ArticleMeta from '../features/diary/components/ArticleMeta.astro';
import CodeCopyButton from '../features/diary/components/CodeCopyButton.astro';
import ReadingProgress from '../features/diary/components/ReadingProgress.astro';
import TableOfContents from '../features/diary/components/TableOfContents.astro';
import type { ContentDiaryEntry } from '../features/diary/diary-content';
import { withBase } from '../site/site-url';
import BaseLayout from './BaseLayout.astro';

interface Heading { depth: number; slug: string; text: string; }
interface Props { entry: ContentDiaryEntry; headings: Heading[]; previous?: ContentDiaryEntry; next?: ContentDiaryEntry; }
const { entry, headings, previous, next } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.cover} article>
  <ReadingProgress />
  <header class="article-header shell"><div class="article-header__content"><p class="eyebrow">日记 · {entry.data.publishedAt.toLocaleDateString('zh-CN')}</p><h1>{entry.data.title}</h1><p class="article-summary">{entry.data.description}</p><ArticleMeta publishedAt={entry.data.publishedAt} /></div></header>
  {entry.data.cover && <img class="article-cover" src={withBase(entry.data.cover)} alt="" width="1600" height="900" />}
  <div class="article-reading-shell shell"><div class="article-toc"><TableOfContents headings={headings} /></div><article class="article-body"><slot /></article></div>
  <nav class="article-nav shell" aria-label="相邻日记">{previous ? <a href={withBase(`/diary/${previous.id}/`)}><span>较新一篇</span><strong>{previous.data.title}</strong></a> : <span></span>}{next ? <a href={withBase(`/diary/${next.id}/`)}><span>较早一篇</span><strong>{next.data.title}</strong></a> : <span></span>}</nav>
  <CodeCopyButton />
</BaseLayout>
