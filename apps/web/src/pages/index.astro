---
import HeroFeature from '../features/home/HeroFeature.astro';
import DiaryCard from '../features/diary/components/DiaryCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedDiaryEntries } from '../features/diary/diary-content';
import { withBase } from '../site/site-url';

const entries = await getPublishedDiaryEntries();
---

<BaseLayout>
  <HeroFeature />

  <section class="shell content-section section-rule" aria-labelledby="latest-title">
    <header class="section-head">
      <div>
        <p class="eyebrow">Personal journal</p>
        <h2 id="latest-title">最近日记</h2>
      </div>
      <a href={withBase('/diary/')}>查看日记 →</a>
    </header>
    {entries.length > 0 ? <div class="post-grid">{entries.map((entry, index) => <DiaryCard entry={entry} index={index} />)}</div> : <div class="empty-state"><span>00</span><p>还没有日记。这里会慢慢记录新的学习与思考。</p></div>}
  </section>

  <section class="shell content-section section-rule about-grid home-introduction" aria-labelledby="home-about-title">
    <p class="eyebrow" id="home-about-title">写在这里</p>
    <div class="home-introduction__content">
      <p>把工作中的思考、学习中的收获和项目里的经验，整理成可以回看的记录。</p>
      <a href={withBase('/about/')}>查看关于页 →</a>
    </div>
  </section>
</BaseLayout>
