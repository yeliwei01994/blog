---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../site/site-url';
---

<BaseLayout title="页面未找到" description="这个页面不存在或已被移动。">
  <section class="hero editorial-grid shell">
    <div class="hero-copy"><p class="eyebrow">Error / 404</p><h1 class="hero-title">Lost<br /><span class="outline">Page</span></h1><p class="hero-intro">这个页面还没有内容，或者它已经被移动到新的位置。</p><p><a href={withBase('/')}>返回首页 →</a>　<a href={withBase('/diary/')}>查看日记 →</a></p></div>
  </section>
</BaseLayout>
