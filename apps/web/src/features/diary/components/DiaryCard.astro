---
import type { ContentDiaryEntry } from '../diary-content';
import { withBase } from '../../../site/site-url';
import ArticleMeta from './ArticleMeta.astro';

interface Props { entry: ContentDiaryEntry; index: number; }
const { entry, index } = Astro.props;
---

<article class:list={['post-card', { 'post-card--featured': index === 0 }]}>
  {entry.data.cover && <div class="post-card__image"><img src={withBase(entry.data.cover)} alt="" width="1600" height="900" loading={index > 1 ? 'lazy' : 'eager'} /></div>}
  <ArticleMeta publishedAt={entry.data.publishedAt} />
  <h3><a href={withBase(`/diary/${entry.id}/`)}>{entry.data.title}</a></h3>
  <p>{entry.data.description}</p>
</article>
