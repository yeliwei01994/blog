---
import './guestbook.css';

interface Props {
  apiBaseUrl: string;
}

const { apiBaseUrl } = Astro.props;
---

<section class="messages-panel" data-guestbook data-api-base-url={apiBaseUrl} aria-live="polite">
  <form class="message-form" data-message-form>
    <div class="message-field">
      <label for="guestbook-name">你的名字</label>
      <input id="guestbook-name" name="name" placeholder="例如：叶厉为" maxlength="80" required />
    </div>
    <div class="message-field">
      <label for="guestbook-message">留言内容</label>
      <textarea id="guestbook-message" name="message" placeholder="写下一句想说的话" maxlength="2000" required></textarea>
    </div>
    <button type="submit">提交留言</button>
    <p class="form-status" data-form-status></p>
  </form>
  <p data-messages-status>正在加载留言……</p>
  <div class="messages-list" data-messages-list></div>
</section>

<script>
  import { initializeGuestbook } from './guestbook-client';

  for (const root of document.querySelectorAll<HTMLElement>('[data-guestbook]')) {
    void initializeGuestbook(root, root.dataset.apiBaseUrl ?? 'http://localhost:3000');
  }
</script>
