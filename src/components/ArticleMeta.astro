---
interface Props {
  publishedAt: Date;
  readingMinutes?: number;
}
const { publishedAt, readingMinutes } = Astro.props;
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(publishedAt);
---

<div class="post-card__meta">
  <time datetime={publishedAt.toISOString()}>{date}</time>
  {readingMinutes && <span>{readingMinutes} MIN READ</span>}
</div>
