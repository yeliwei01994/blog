---
import { withBase } from '../lib/urls';
---

<button class="icon-button" type="button" data-search-open aria-label="打开文章搜索" title="搜索文章">
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
</button>

<dialog class="search-dialog" data-search-dialog data-search-url={withBase('/search-index.json')} aria-labelledby="search-title">
  <div class="search-panel">
    <header class="search-head">
      <div><p class="eyebrow">Search the archive</p><h2 id="search-title">搜索文章</h2></div>
      <form method="dialog"><button class="icon-button" aria-label="关闭搜索" title="关闭"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 5l14 14M19 5 5 19"></path></svg></button></form>
    </header>
    <label for="site-search">关键词</label>
    <input id="site-search" class="search-input" data-search-input type="search" placeholder="例如：Astro、设计、写作" autocomplete="off" />
    <div class="search-results" data-search-results aria-live="polite"><p class="search-empty">输入标题、摘要或标签开始搜索。</p></div>
  </div>
</dialog>

<script>
  import '../scripts/search';
</script>
