---
import type { ContentDiaryEntry } from '../lib/content';
import { withBase } from '../lib/urls';
import ArticleMeta from './ArticleMeta.astro';

interface Props { entry: ContentDiaryEntry; index: number; }
const { entry, index } = Astro.props;
---

<article class="post-card">
  {entry.data.cover && <div class="post-card__image"><span class="post-card__number">{String(index + 1).padStart(2, '0')}</span><img src={withBase(entry.data.cover)} alt="" width="1600" height="900" loading={index > 1 ? 'lazy' : 'eager'} /></div>}
  <ArticleMeta publishedAt={entry.data.publishedAt} />
  <h3><a href={withBase(`/diary/${entry.id}/`)}>{entry.data.title}</a></h3>
  <p>{entry.data.description}</p>
</article>
