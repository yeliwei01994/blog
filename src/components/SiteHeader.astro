---
import { SITE } from '../config/site';
import { withBase } from '../lib/urls';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header shell">
  <a class="brand" href={withBase('/')} aria-label={`${SITE.title} 首页`}>YE<span>/</span>blog</a>
  <nav class="site-nav" aria-label="主导航">
    {SITE.nav.map((item) => (
      <a href={withBase(item.href)} aria-current={currentPath === withBase(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <div class="header-actions"><ThemeToggle /></div>
</header>
