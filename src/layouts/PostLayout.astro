---
import ArticleMeta from '../components/ArticleMeta.astro';
import CodeCopyButton from '../components/CodeCopyButton.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { ContentPost } from '../lib/content';
import { withBase } from '../lib/urls';
import BaseLayout from './BaseLayout.astro';

interface Heading { depth: number; slug: string; text: string; }
interface Props { post: ContentPost; headings: Heading[]; previous?: ContentPost; next?: ContentPost; }
const { post, headings, previous, next } = Astro.props;
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} article>
  <ReadingProgress />
  <header class="article-hero shell">
    <p class="eyebrow">Field note / {post.id}</p>
    <h1>{post.data.title}</h1>
    <p class="hero-intro">{post.data.description}</p>
    <ArticleMeta publishedAt={post.data.publishedAt} tags={post.data.tags} />
  </header>
  {post.data.cover && <img class="article-cover" src={withBase(post.data.cover)} alt="" width="1600" height="900" />}
  <div class="article-shell shell">
    <TableOfContents headings={headings} />
    <article class="article-body"><slot /></article>
    <aside class="article-aside"><p class="eyebrow">FORM / FUTURE</p><p>OPEN NOTE<br />{post.data.publishedAt.getFullYear()}</p></aside>
  </div>
  <nav class="article-nav shell" aria-label="相邻文章">
    {previous ? <a href={withBase(`/posts/${previous.id}/`)}><span>较新一篇</span><strong>{previous.data.title}</strong></a> : <span></span>}
    {next ? <a href={withBase(`/posts/${next.id}/`)}><span>较早一篇</span><strong>{next.data.title}</strong></a> : <span></span>}
  </nav>
  <CodeCopyButton />
</BaseLayout>
