---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';
const posts = await getPublishedPosts();
---

<BaseLayout title="文章" description="FORM / FUTURE 的全部文章与公开笔记。">
  <header class="page-hero shell"><h1>All<br />Stories</h1><p>按时间排列的全部文章。每一篇都是可以继续修订的开放记录。</p></header>
  <section class="shell content-section"><div class="post-grid">{posts.map((post, index) => <PostCard post={post} index={index} />)}</div></section>
</BaseLayout>
