---
import HeroFeature from '../components/HeroFeature.astro';
import PostCard from '../components/PostCard.astro';
import TagChip from '../components/TagChip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/content';
import { getAllTags } from '../lib/posts';
import { withBase } from '../lib/urls';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout>
  <HeroFeature />

  <section class="shell content-section section-rule" aria-labelledby="latest-title">
    <header class="section-head">
      <div>
        <p class="eyebrow">Latest dispatches</p>
        <h2 id="latest-title">最新文章</h2>
      </div>
      <a href={withBase('/posts/')}>浏览全部 →</a>
    </header>
    <div class="post-grid">
      {posts.map((post, index) => <PostCard post={post} index={index} size={index === 0 ? 'feature' : 'standard'} />)}
    </div>
  </section>

  <section class="shell content-section section-rule" aria-labelledby="topics-title">
    <header class="section-head">
      <div><p class="eyebrow">Index by subject</p><h2 id="topics-title">主题索引</h2></div>
    </header>
    <ul class="tag-list">{tags.map((tag) => <li><TagChip {...tag} /></li>)}</ul>
  </section>

  <section class="shell content-section section-rule about-grid">
    <p class="eyebrow">About this publication / No. 001</p>
    <div>
      <p class="about-lead">一个持续更新的个人编辑部：把工程实践、视觉判断和生活中的微小发现整理成可检索的公开笔记。</p>
      <a href={withBase('/about/')}>认识作者与这份博客 →</a>
    </div>
  </section>
</BaseLayout>
