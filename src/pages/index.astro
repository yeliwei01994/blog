---
import HeroFeature from '../components/HeroFeature.astro';
import DiaryCard from '../components/DiaryCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedDiaryEntries } from '../lib/content';
import { withBase } from '../lib/urls';

const entries = await getPublishedDiaryEntries();
---

<BaseLayout>
  <HeroFeature />

  <section class="shell content-section section-rule" aria-labelledby="latest-title">
    <header class="section-head">
      <div>
        <p class="eyebrow">Personal journal</p>
        <h2 id="latest-title">最近日记</h2>
      </div>
      <a href={withBase('/diary/')}>查看日记 →</a>
    </header>
    {entries.length > 0 ? <div class="post-grid">{entries.map((entry, index) => <DiaryCard entry={entry} index={index} />)}</div> : <div class="empty-state"><span>00</span><p>还没有日记。这里会慢慢记录新的学习与思考。</p></div>}
  </section>

  <section class="shell content-section section-rule about-grid">
    <p class="eyebrow">About this publication / No. 001</p>
    <div>
      <p class="about-lead">学习并成为一名全职开发者</p>
      <a href={withBase('/about/')}>认识作者与这份博客 →</a>
    </div>
  </section>
</BaseLayout>
