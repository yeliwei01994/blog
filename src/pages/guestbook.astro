---
import BaseLayout from '../layouts/BaseLayout.astro';
import Guestbook from '../features/guestbook/Guestbook.astro';

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';
---

<BaseLayout title="Guestbook" description="来自 PostgreSQL 的留言板">
  <section class="shell guestbook-page">
    <header class="page-hero">
      <p class="eyebrow">PostgreSQL practice</p>
      <h1>Guestbook</h1>
      <p>这些留言来自独立 API，再由 API 从 PostgreSQL 读取。</p>
    </header>

    <Guestbook apiBaseUrl={apiBaseUrl} />
  </section>
</BaseLayout>
