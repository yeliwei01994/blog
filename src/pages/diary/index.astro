---
import DiaryCard from '../../features/diary/components/DiaryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedDiaryEntries } from '../../features/diary/diary-content';
const entries = await getPublishedDiaryEntries();
---

<BaseLayout title="日记" description="叶厉为的个人日记。">
  <header class="page-hero shell"><h1>Diary</h1><p>记录学习、实践和阶段性思考。</p></header>
  <section class="shell content-section">
    {entries.length > 0 ? <div class="post-grid">{entries.map((entry, index) => <DiaryCard entry={entry} index={index} />)}</div> : <div class="empty-state"><span>00</span><p>还没有日记。第一篇内容会在准备好之后出现在这里。</p></div>}
  </section>
</BaseLayout>
