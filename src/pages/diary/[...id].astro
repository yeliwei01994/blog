---
import { render } from 'astro:content';
import DiaryLayout from '../../layouts/DiaryLayout.astro';
import { getPublishedDiaryEntries, type ContentDiaryEntry } from '../../lib/content';
import { getAdjacentEntries } from '../../lib/diary';

export async function getStaticPaths() {
  const entries = await getPublishedDiaryEntries();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, entries } }));
}

interface Props { entry: ContentDiaryEntry; entries: ContentDiaryEntry[]; }
const { entry, entries } = Astro.props;
const { Content, headings } = await render(entry);
const { previous, next } = getAdjacentEntries(entries, entry.id);
---

<DiaryLayout entry={entry} headings={headings} previous={previous} next={next}><Content /></DiaryLayout>
